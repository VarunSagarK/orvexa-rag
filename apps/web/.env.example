# ─────────────────────────────────────────────────────────────────
# ORVEXA Web — Environment Variables Template (BROWSER-VISIBLE)
#
# Copy this file to apps/web/.env and fill in your real values.
#
# Every VITE_ variable is baked into the public JavaScript bundle.
# Only put values here that are safe for anyone to read.
# NEVER add the service role key, the OpenAI key, or any other secret.
# ─────────────────────────────────────────────────────────────────

# Found in: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The ORVEXA API (apps/api)
VITE_API_URL=http://localhost:3000
