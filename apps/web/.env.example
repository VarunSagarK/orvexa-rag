# ORVEXA web app + API (Next.js) — copy to .env.local and fill in real values.
# NEVER commit .env.local. Real production values live in Vercel's environment settings.

# ── Browser-visible (shipped in the public JavaScript bundle) ──────────────
# Anything prefixed NEXT_PUBLIC_ is readable by anyone. Never put a secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Server-only (used only in apps/web/src/server/ and route handlers) ─────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Bypasses Row Level Security. Ingestion only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini. Free tier: sample documents and test accounts only (see CLAUDE.md, privacy gate).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_RERANK_MODEL=gemini-2.5-flash-lite
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
# A different, larger model than the one that writes answers.
GEMINI_FAITHFULNESS_MODEL=gemini-2.5-flash

NODE_ENV=development
DEFAULT_BUILDING_NAME=Example Tower

# ── RAG settings (placeholders, to be measured) ──────────────────────────
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CONFIDENCE_THRESHOLD=0.72
RAG_DAILY_QUERY_LIMIT=20
UPLOAD_MAX_MB=50
