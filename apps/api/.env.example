# ─────────────────────────────────────────────────────────────────
# ORVEXA API — Environment Variables Template (SERVER ONLY)
#
# Copy this file to apps/api/.env and fill in your real values.
# NEVER commit .env to Git. This file (.env.example) is safe to commit
# because it contains only placeholder values, never real secrets.
#
# Nothing in this file may ever be given to the web app. Browser-safe
# values live in apps/web/.env.example.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: supabase.com → your project → Settings → API

SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — the API uses it to build a Supabase client per request
# from the caller's own access token, so Row Level Security applies.
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — bypasses Row Level Security completely.
# Use ONLY for document ingestion. Never for resident or concierge requests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Access tokens are verified with supabase.auth.getUser(token), which works
# with both legacy JWT secrets and newer asymmetric signing keys, so no
# JWT secret is needed here.

# ── OpenAI ────────────────────────────────────────────────────
# Found in: platform.openai.com → API keys
# Set a monthly spend cap in the OpenAI dashboard before going live.

OPENAI_API_KEY=sk-your-openai-api-key-here

# Model names. Do not change these defaults without asking.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-4o-mini
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_FAITHFULNESS_MODEL=gpt-4o-mini

# ── API server ────────────────────────────────────────────────
# Port the Express server listens on locally
PORT=3000

# The URL of your frontend app (used for CORS)
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (update when you deploy to Vercel):
# FRONTEND_URL=https://orvexa.vercel.app

# ── App config ────────────────────────────────────────────────
# Environment: development | production
NODE_ENV=development

# Fallback building name shown in the AI system prompt.
# The real name comes from the user's building (looked up server-side).
DEFAULT_BUILDING_NAME=Example Tower

# RAG settings — PLACEHOLDERS, to be measured against the eval set.
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CONFIDENCE_THRESHOLD=0.72
# Daily per-user limit. The counter is stored in Postgres, not in memory.
RAG_DAILY_QUERY_LIMIT=20

# Upload limit in megabytes — placeholder; bylaw files are usually far smaller.
UPLOAD_MAX_MB=50
